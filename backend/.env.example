# Shine Limos backend — example environment (copy to .env and fill in).
# NEVER commit a real .env with secrets.

# Existing (already required by the backend)
SECRET_KEY=
MONGO_URI=
EMAIL_USER=
EMAIL_PASS=

# Driver app v1 — SMS login codes.
# Provider order: Zadarma first, Twilio fallback. Fill in ONLY the
# provider you use; leave the other blank. If neither is configured,
# POST /driver/request-code fails cleanly (503) and no code is ever
# logged or returned.
#
# Zadarma (first): key + secret from my.zadarma.com → Settings →
# Integrations and API. SMS_SENDER is optional — a verified Zadarma
# number or registered text SenderID; omit to use the account default.
ZADARMA_KEY=
ZADARMA_SECRET=
SMS_SENDER=
#
# Twilio (fallback): from the Twilio console. TWILIO_FROM must be a
# Twilio number (or Messaging Service SID) on the account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
